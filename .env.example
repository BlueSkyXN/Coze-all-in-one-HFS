# Local HFS v2 value ledger. Do not commit a populated .env file.
# HF_TOKEN and GH_TOKEN are local control-plane credentials only; do not sync them.
HF_TOKEN=
GH_TOKEN=

# Space runtime artifact delivery. The manifest URL must be a direct HTTPS URL
# with no query string, fragment, or embedded credentials.
COZE_RUNTIME_MANIFEST_URI=
COZE_RUNTIME_DOWNLOAD_TOKEN=

# Non-sensitive Space Variables.
DISABLE_USER_REGISTRATION=true
ENABLE_LOCAL_MINIO=1
COZE_PUBLIC_URL=
LOG_LEVEL=info
PERSISTENCE_REQUIRED=false
CODE_RUNNER_TYPE=sandbox
ADMIN_ENABLED=false

# Space Secrets. Keep values empty in this template.
OPS_TOKEN=
ADMIN_TOKEN=
ADMIN_CSRF_KEY=
MODEL_API_KEY_0=
BUILTIN_CM_OPENAI_API_KEY=
OPENAI_EMBEDDING_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=
ES_PASSWORD=
VIKING_DB_AK=
VIKING_DB_SK=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
