# Clean no-paid Hugging Face Space Variables / Secrets example.
# Put secrets such as API keys in Secrets, not public Variables.

# Public URL: usually generated automatically from SPACE_HOST.
# COZE_PUBLIC_URL=https://your-space-username-your-space-name.hf.space

# Required after hybrid artifact cutover. Use a direct HTTPS manifest URL without
# credentials, query string, or fragment. Put COZE_RUNTIME_DOWNLOAD_TOKEN (if
# needed) in HF Secrets, never in this URL.
# COZE_RUNTIME_MANIFEST_URI=https://artifact.example/coze-all-in-one-hfs/release/manifest.json

DISABLE_USER_REGISTRATION=true
CODE_RUNNER_TYPE=sandbox
PERSISTENCE_REQUIRED=false

# Registration allowlists, model/provider settings, external S3 endpoint settings,
# and external VikingDB endpoint settings are intentionally absent. Add them only
# as a coherent, reviewed extension profile; do not sync empty or placeholder values.

# Ops dashboard/API: put OPS_TOKEN in HF Secrets for public Spaces.
# OPS_TOKEN=replace-me-with-random-token

# Admin is default-off. Only enable for short controlled maintenance windows.
# Keep ADMIN_TOKEN in HF Secrets and do not reuse OPS_TOKEN.
# ADMIN_ENABLED=false
# ADMIN_TOKEN=replace-me-with-different-random-token

# Storage: prefer S3/TOS/ImageX for public HTTPS URLs.
# FILE_UPLOAD_COMPONENT_TYPE=storage
# STORAGE_TYPE=s3
# STORAGE_UPLOAD_HTTP_SCHEME=https
# S3_ACCESS_KEY=replace-me
# S3_SECRET_KEY=replace-me
# STORAGE_BUCKET=opencoze
# Add the complete provider endpoint and region tuple outside this clean profile.
# Set ENABLE_LOCAL_MINIO=0 only when MINIO_ADDRESS points to external object storage
# that bundled Milvus can reach, and the bucket already exists.
# ENABLE_LOCAL_MINIO=0
# MINIO_ADDRESS=minio.example.com:9000

# Knowledge/RAG: built-in Elasticsearch + Milvus is the default all-in-one path.
# Only set these when overriding to external managed services.
# ES_ADDR=https://your-es-endpoint
# ES_VERSION=v8
# ES_USERNAME=...
# ES_PASSWORD=...
# VECTOR_STORE_TYPE=vikingdb
# VIKING_DB_AK=...
# VIKING_DB_SK=...
# Add the complete external vector endpoint tuple outside this clean profile.
# EMBEDDING_TYPE=openai
# OPENAI_EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# OPENAI_EMBEDDING_API_KEY=replace-me
